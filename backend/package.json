{
  "name": "event-feedback-system-backend",
  "version": "1.0.0",
  "description": "Backend for Event Feedback System",
  "main": "server.js",
  "scripts": {
    "test": "mocha",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "node server.js",
    "drop": "node db/drop.js",
    "reset": "npm run drop && npm run seed:users && npm run seed:events",
    "seed:users": "node db/seedUsers.js",
