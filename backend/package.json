    "drop:events": "node db/dropEvents.js",
    "reset:events": "npm run drop:events && npm run seed:events"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chai": "^4.5.0",
    "chai-http": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.0.14",
    "request": "^2.88.2"
  },
  "devDependencies": {
    "esm": "^3.2.25",
    "mocha": "^11.0.1",
    "nodemon": "^2.0.15",
    "sinon": "^19.0.2"
  },
